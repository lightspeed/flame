{
  "extends": "@lightspeed/config-typescript/base",
  "compilerOptions": {
    "allowJs": true,
    "strictNullChecks": false,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "baseUrl": ".",
    "paths": {
      "test-utils": ["tests/test-utils"]
    }
  },
  "exclude": [
    "**/*.js",
    "**/dist/**",
    "scripts/plop/templates/**/*",
    "packages/flame-tokens/story.tsx",
    "**/*.stories.tsx",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/examples/**",
    "**/story.tsx",
    "packages/flame/src/Flag/*.tsx",
    "**/node_modules/**"
  ]
}
